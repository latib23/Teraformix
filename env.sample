# Runtime
NODE_ENV=development
PORT=3000
ASSET_BASE_URL=
ENFORCE_HTTPS=false
TRUST_PROXY_HOPS=0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENABLE_LEGACY_REDIRECTS=false

# Database
DATABASE_URL=
PGHOST=localhost
PGHOST_PUBLIC=
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=teraformix
DB_SYNC=false

# Auth and seed data
JWT_SECRET=replace-with-a-long-random-secret
SEED_DEFAULT_USERS=false
SEED_ADMIN_PASSWORD=
SEED_SALES_PASSWORD=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
RATE_LIMIT_LOGIN_MAX=40
RATE_LIMIT_HEAVY_MAX=120
RATE_LIMIT_VIOLATIONS=5
RATE_LIMIT_BLOCK_MS=300000

# Payments
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
RECAPTCHA_ENFORCE=false
RECAPTCHA_SECRET=
RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.3
RECAPTCHA_EXPECT_ACTION=checkout

# Shipping
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=

# Email
MAILTRAP_TOKEN=
MAILTRAP_FROM=noreply@teraformix.com
MAILTRAP_FROM_NAME=Teraformix
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=

# Search and AI
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
OPENAI_API_KEY=
VITE_GEMINI_API_KEY=

# Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_FORMS_BASE_ID=
AIRTABLE_CUSTOMERS_TABLE=Customers
AIRTABLE_ORDERS_TABLE=Orders
AIRTABLE_FORMS_TABLE_NAME=Leads

# Xero
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REFRESH_TOKEN=
XERO_TENANT_ID=

# Analytics and marketing
GA_MEASUREMENT_ID=
GTM_CONTAINER_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_LEAD_LABEL=
CLARITY_PROJECT_ID=
APOLLO_TRACKER_APP_ID=
